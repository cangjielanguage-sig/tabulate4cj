@Test
public class TestGrapheme {
    @TestCase
    func testLate() {
        let gr = newGraphemes("x")
        gr.next()
        gr.next()
        let r = gr.runes()
        @Expect(r.isNone(), true)
        let (from, to) = gr.positions()
        @Expect(from,1)
        @Expect(to,1)
    }

    @TestCase
    func testEarly() {
        let gr = newGraphemes("test")
        let r = gr.runes()
        @Expect(r.isNone(), true)
        let (from, to) = gr.positions()
        @Expect(from,0)
        @Expect(to,0)
    }

    @TestCase
    func testSimple() {
        for (testCase in testArray) {
            let gr = newGraphemes(testCase.original)
            var index = 0
            while (gr.next()) {
                @Expect(index < testCase.expected.size, true)
                let cluster = gr.runes() ?? Array<Rune>()
                @Expect(cluster.size == testCase.expected[index].size, true)
                var i = 0
                for (r in cluster) {
                    @Expect(r == testCase.expected[index][i])
                    i++
                }
                index++
            }
            @Expect(index >= testCase.expected.size, true)
        }
    }
}
